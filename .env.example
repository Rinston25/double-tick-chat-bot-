# ─────────────────────────────────────────────────────────────────────────
# Mahindra AI Chat Agent — environment configuration
# Copy this file to `.env` in the repo root and fill in the values.
# The server (server/src/config/env.ts) loads and validates this file with
# zod at boot and will refuse to start if a required value is missing or
# malformed — read the error message, it names the exact variable.
# ─────────────────────────────────────────────────────────────────────────

# ---- Server -----------------------------------------------------------
# Port the Fastify server listens on.
PORT=4000

# Log verbosity for pino (fatal|error|warn|info|debug|trace).
LOG_LEVEL=info

# Origin of the Next.js web app. CORS only allows this origin.
WEB_ORIGIN=http://localhost:3000

# ---- Groq (LLM) ---------------------------------------------------------
# API key from https://console.groq.com/keys
GROQ_API_KEY=

# Main tool-calling agent model. Groq periodically retires/renames models —
# if you get a 404 "model_not_found", check https://console.groq.com/docs/models
# (or GET https://api.groq.com/openai/v1/models with your key) for current names.
GROQ_MODEL_AGENT=openai/gpt-oss-120b

# Small, fast model used only for per-turn stage classification.
GROQ_MODEL_CLASSIFIER=openai/gpt-oss-20b

# ---- Session store (Redis) ---------------------------------------------
# Optional. When unset the server automatically falls back to an in-memory
# session store (fine for local dev / demo, not for multi-instance deploys).
# Example: redis://localhost:6379
REDIS_URL=

# ---- Zoho CRM OAuth -------------------------------------------------------
# Create a Self Client at https://api-console.zoho.in (see docs/ZOHO_SETUP.md).
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# Obtained by running `npm run zoho:token -- <grant_code>` (see docs/ZOHO_SETUP.md).
ZOHO_REFRESH_TOKEN=

# Zoho data center. Defaults below are for the INDIA data center (.in).
# If your Zoho org is on a different data center, change ALL THREE of these
# together (they must match the DC your Self Client / org was created in):
#   United States : accounts.zoho.com   / www.zohoapis.com
#   Europe        : accounts.zoho.eu    / www.zohoapis.eu
#   India         : accounts.zoho.in    / www.zohoapis.in
#   Australia     : accounts.zoho.com.au/ www.zohoapis.com.au
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_API_DOMAIN=https://www.zohoapis.in
ZOHO_API_VERSION=v7

# ---- Web (Next.js) --------------------------------------------------------
# Base URL of the Fastify API, used by the browser. Must be reachable from
# the client — do not point this at an internal/docker-only hostname.
NEXT_PUBLIC_API_URL=http://localhost:4000
